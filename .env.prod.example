# Copy to .env.prod and fill in real values before `make prod`.
# .env.prod is gitignored — this .example file is the only one committed.
# Use a real random SECRET_KEY (e.g. `openssl rand -hex 32`) and a strong
# MYSQL_ROOT_PASSWORD — these placeholders are not safe to run with.
MYSQL_ROOT_PASSWORD=changeme-prod-password
MYSQL_DATABASE=chat_realtime_demo
SECRET_KEY=changeme-prod-secret-key-use-a-real-random-value
ALLOWED_ORIGINS=["http://localhost:5175"]
VITE_API_URL=http://localhost:9000/api/v1
VITE_WS_URL=ws://localhost:9000/api/v1
NGINX_PORT=9000
FRONTEND_PORT=5175

# Strongly recommended in production — leaving these unset just means
# unhandled errors go unreported, the app still runs fine either way.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── RAG chatbot (/chat-bot) ────────────────────────────────────────────────
# Optional — leave OPENAI_API_KEY unset to keep the chatbot off. /api/v1/bot
# and /api/v1/documents then return 503 and the rest of the app is unaffected.
# This is a real, billable secret: never commit the filled-in .env.prod.
# OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_COLLECTION=internal_docs
# Chunks retrieved per question, and the cosine-distance ceiling above which a
# chunk is considered irrelevant (0 = identical, 2 = opposite). Lower
# RAG_MAX_DISTANCE to make the assistant stricter about only answering from
# the documents; raise it if it declines to answer too often.
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75
