# Copy to .env.prod and fill in real values before `make prod`.
# .env.prod is gitignored — this .example file is the only one committed.
# Use a real random SECRET_KEY (e.g. `openssl rand -hex 32`) and a strong
# MYSQL_ROOT_PASSWORD — these placeholders are not safe to run with.
MYSQL_ROOT_PASSWORD=changeme-prod-password
MYSQL_DATABASE=chat_realtime_demo
SECRET_KEY=changeme-prod-secret-key-use-a-real-random-value
ALLOWED_ORIGINS=["http://localhost:5175"]
VITE_API_URL=http://localhost:9000/api/v1
VITE_WS_URL=ws://localhost:9001/api/v1
NGINX_PORT=9000
FRONTEND_PORT=5175

# Strongly recommended in production — leaving these unset just means
# unhandled errors go unreported, the app still runs fine either way.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
