# WebSocket service. Only four settings matter, and two of them must match the
# HTTP API project exactly.

# Same database as the API. Read-mostly: token/membership checks, plus the
# is_online/last_seen_at columns. Migrations belong to the API project.
DATABASE_URL=mysql+aiomysql://root:PASSWORD@localhost:3306/chat_realtime_demo

# MUST be the same Redis instance as the API — this is how messages published
# there reach sockets held here.
REDIS_URL=redis://localhost:6379/0

# MUST match the API's SECRET_KEY. This service only verifies tokens the API
# issued; a mismatch rejects every socket with close code 4001.
SECRET_KEY=your-secret-key

# Optional
# SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
