# Real secrets — never commit these. docker-compose.yml doesn't depend on
# .env existing (its values are hardcoded there or have ${VAR:-default}
# fallbacks), so `docker compose up` works identically with or without it.
.env
.env.*
!.env.staging.example
!.env.prod.example

.DS_Store

# Scratch folder for documents you're about to upload to the RAG knowledge
# base. The app never reads from here — uploads are parsed straight from the
# HTTP request and never written to disk — so this is purely a convenient
# staging spot. Ignored because real internal documents must never be
# committed.
demo_docs/
