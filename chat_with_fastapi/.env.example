APP_NAME=API_CHAT_REALTIME
APP_VERSION=1.0.0
# DEBUG=false
API_PREFIX=/api/v1

DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@localhost:3306/YOUR_DATABASE_NAME
DATABASE_SYNC_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/YOUR_DATABASE_NAME

REDIS_URL=redis://localhost:6379/0

# Optional — avatar uploads. All three have working defaults, so nothing here
# is required; set UPLOAD_DIR if the process can't write to ./uploads. In
# Docker this path is a volume shared by every API replica (see the compose
# files), because nginx round-robins and the replica serving a file is rarely
# the one that wrote it.
# UPLOAD_DIR=uploads
# UPLOAD_URL_PREFIX=/uploads
# MAX_AVATAR_BYTES=5242880

# Optional — leave unset to disable Sentry entirely (the default).
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.0
