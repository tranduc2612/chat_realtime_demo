APP_NAME=API_CHAT_REALTIME
APP_VERSION=1.0.0
# DEBUG=false
API_PREFIX=/api/v1

DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@localhost:3306/YOUR_DATABASE_NAME
DATABASE_SYNC_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/YOUR_DATABASE_NAME

REDIS_URL=redis://localhost:6379/0

# CORS — JSON array of browser origins allowed to call this API. Required:
# leaving it unset means no origin is allowed and the frontend gets blocked.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]

# Optional — leave unset to disable Sentry entirely (the default).
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ── RAG chatbot (/api/v1/bot, /api/v1/documents) ───────────────────────────
# Optional — leave OPENAI_API_KEY unset to disable the chatbot entirely (the
# default). Those two route groups then return 503; everything else runs
# normally. Get a key at https://platform.openai.com/api-keys.
# OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Changing the embedding model or dimensions invalidates every stored vector —
# delete the Chroma collection and re-upload all documents afterwards.
OPENAI_EMBEDDING_DIMENSIONS=1536

# ChromaDB vector store. `docker compose up` runs it as the `chroma` service
# and publishes it on 8100; for a non-Docker `make dev` against that stack use
# CHROMA_HOST=localhost / CHROMA_PORT=8100.
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_COLLECTION=internal_docs

# Retrieval tuning — RAG_MAX_DISTANCE is a cosine-distance ceiling (0 =
# identical, 2 = opposite). Lower it to make the bot stricter about only
# answering from the documents; raise it if it refuses too eagerly.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75
RAG_MAX_HISTORY=10
RAG_MAX_UPLOAD_MB=10
