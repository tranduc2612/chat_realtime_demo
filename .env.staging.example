# Copy to .env.staging and fill in real values before `make staging`.
# .env.staging is gitignored — this .example file is the only one committed.
MYSQL_ROOT_PASSWORD=changeme-staging-password
MYSQL_DATABASE=chat_realtime_demo_staging
SECRET_KEY=changeme-staging-secret-key
ALLOWED_ORIGINS=["http://localhost:5174"]
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/api/v1
NGINX_PORT=8080
FRONTEND_PORT=5174

# Optional — leave both unset to keep Sentry off in staging too.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.2

# ── RAG chatbot (/chat-bot) ────────────────────────────────────────────────
# Optional — leave OPENAI_API_KEY unset to keep the chatbot off. /api/v1/bot
# and /api/v1/documents then return 503 and the rest of the app is unaffected.
# This is a real, billable secret: never commit the filled-in .env.staging.
# OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_COLLECTION=internal_docs_staging
# Chunks retrieved per question, and the cosine-distance ceiling above which a
# chunk is considered irrelevant (0 = identical, 2 = opposite). Lower
# RAG_MAX_DISTANCE to make the assistant stricter about only answering from
# the documents; raise it if it declines to answer too often.
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75
